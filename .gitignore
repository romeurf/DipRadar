# ── Environment ─────────────────────────────────────────────────────────
.env
.env.*
!.env.example
.venv/
venv/



# Generated training reports (intermediate). The production report
# ml_report_v3.json is tracked (consumed by /admin and health_monitor).
*.json.tmp

# ── Local data (Railway volume mount in production) ────────────────────
# The /data/ tree is the Railway persistent volume — runtime artifacts
# (parquets, JSONs, pickles, CSVs) must NOT be committed. The previous
# rules `data/` and `/data/` excluded the directory itself, which made
# git unable to re-include any source .py files inside it (gitignore
# can't re-include children of an excluded directory). Use file-level
# globs instead: ignore contents but keep .py source tracked.
data/*
!data/*.py
!data/**/
!data/**/*.py

# ── Parquet artifacts ───────────────────────────────────────────────────
# Exclude all parquet files except the two cold-start seeds committed to
# the repo root. These are copied to /data/ on the first Railway deploy
# when the volume is empty (see monthly_retrain.py BOOTSTRAP_FALLBACK).
*.parquet
!ml_training_base.parquet
!core_training_base.parquet

# ── F.5 dislocation validation cache (per plan A1 decision) ─────────────
# The validation cache is the reproducibility guarantee for the BINDING
# backtest gate. Track in git so re-runs are byte-byte reproducible — a
# gate result that can't be reproduced is a gate that can't be trusted.
# Size estimate: ~25MB total. The metadata + spine + JSON output sit
# alongside the parquets to self-describe the artefact.
!data/validation_cache/
!data/validation_cache/*.parquet
!data/validation_cache/*.json

